{
  "name": "connectly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/precompress.js",
    "migrate": "node server/migrate.js",
    "seed": "node server/seed.js",
    "start": "node server/migrate.js && node server/index.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.13.15",
    "livekit-server-sdk": "^2.19.1",
    "multer": "^2.0.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "livekit-client": "^2.22.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
