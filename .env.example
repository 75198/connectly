DATABASE_URL=postgres://connectly:devpass@localhost:5432/connectly
PORT=3000
NODE_ENV=production
# Public base URL used in password-reset links
APP_URL=http://localhost:3000
# Set to "true" when served over HTTPS (Codespaces public URL is HTTPS)
COOKIE_SECURE=true
UPLOAD_DIR=./uploads
# Email delivery is NOT configured in Milestone 1. Reset links are logged server-side and shown to admins.
# SMTP for confirmation/reset codes (e.g. Brevo: smtp-relay.brevo.com, 587). If unset, codes are logged to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Connectly <no-reply@yourdomain.com>"
# Random secret used to HMAC the 6-digit codes
CODE_SECRET=
# Local dev only: SEED_DEMO=1 npm run seed  (creates alice/bob). Never set in production.
# AI support chat (Connectly Assistant) via Groq free tier. Key stays server-side only.
FEATURE_AI_SUPPORT=0
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# AI_USER_HOURLY=30
# AI_DAILY_CAP=900
# Go Live (LiveKit Cloud free tier). Keep secrets only in .env.
FEATURE_LIVE=0
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVE_MAX_MINUTES=60
# LIVE_MAX_VIEWERS=20
# LIVE_MONTHLY_MINUTES=4500
# Subscriptions (tiers). Payments are pluggable and OFF: checkout says "Coming soon" until PAYMENTS_LIVE=1 and a provider is configured.
FEATURE_SUBSCRIPTIONS=0
PAYMENTS_LIVE=0
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_BUNDLE_ID=
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
WEB_PAYMENTS_ENABLED=0
WEB_PAYMENTS_SECRET_KEY=
# FOLLOW_DAILY_LIMIT=500

# Rounds 7-9, news and starter content (all off by default)
FEATURE_ADD_YOURS=0
FEATURE_AI_VISION=0
FEATURE_AI_VOICE=0
FEATURE_AR_EFFECTS=0
FEATURE_BACKFILL=0
FEATURE_CALLS=0
FEATURE_CHALLENGES=0
FEATURE_CLOSE_FRIENDS=0
FEATURE_COLLECTIONS=0
FEATURE_CREATOR_TOOLS=0
FEATURE_DATA_EXPORT=0
FEATURE_DISAPPEARING=0
FEATURE_DISCOVERABILITY=0
FEATURE_EVENTS=0
FEATURE_FOR_YOU=0
FEATURE_GAMES=0
FEATURE_GIFTS=0
FEATURE_HASHTAGS=0
FEATURE_HIDDEN_WORDS=0
FEATURE_HIDE_LIKES=0
FEATURE_HIDE_LISTS=0
FEATURE_HIDE_PRESENCE=0
FEATURE_I18N=0
FEATURE_LOGIN_ALERTS=0
FEATURE_MEMORIES=0
FEATURE_MESSAGES=0
FEATURE_MUSIC=0
FEATURE_NEWS=0
FEATURE_POLLS=0
FEATURE_PRIVATE_ACCOUNTS=0
FEATURE_PUSH=0
FEATURE_REELS=0
FEATURE_REMIX=0
FEATURE_REPORTS=0
FEATURE_RESTRICT_MUTE=0
FEATURE_SIGNUP_POW=0
FEATURE_STICKERS=0
FEATURE_STREAKS=0
FEATURE_TEEN_SAFETY=0
FEATURE_TRANSLATE=0
FEATURE_TWO_STEP=0
FEATURE_VERIFIED=0
FEATURE_WATCH_TOGETHER=0
FEATURE_WELCOME_HERO=0
FEATURE_WHO_CAN=0
# VAPID keys for push live only in the server .env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FEATURE_LOCAL_CURRENCY=0
FEATURE_DOWNLOADS=0
FEATURE_AUTO_TRANSLATE=0
FEATURE_FRIENDS_FEED=0
FEATURE_AI_CREATOR=0
FEATURE_TIPS=0
FEATURE_LITE_MODE=0
FEATURE_SAFETY_CENTER=0
FEATURE_ANTI_SCAM=0
FEATURE_MSG_CONTROLS=0
FEATURE_PAID_VERIFICATION=0
