DATABASE_URL=postgres://connectly:devpass@localhost:5432/connectly
PORT=3000
NODE_ENV=production
# Public base URL used in password-reset links
APP_URL=http://localhost:3000
# Set to "true" when served over HTTPS (Codespaces public URL is HTTPS)
COOKIE_SECURE=true
UPLOAD_DIR=./uploads
# Email delivery is NOT configured in Milestone 1. Reset links are logged server-side and shown to admins.
# SMTP for confirmation/reset codes (e.g. Brevo: smtp-relay.brevo.com, 587). If unset, codes are logged to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Connectly <no-reply@yourdomain.com>"
# Random secret used to HMAC the 6-digit codes
CODE_SECRET=
# Local dev only: SEED_DEMO=1 npm run seed  (creates alice/bob). Never set in production.
# AI support chat (Connectly Assistant) via Groq free tier. Key stays server-side only.
FEATURE_AI_SUPPORT=0
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# AI_USER_HOURLY=30
# AI_DAILY_CAP=900
# Go Live (LiveKit Cloud free tier). Keep secrets only in .env.
FEATURE_LIVE=0
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVE_MAX_MINUTES=60
# LIVE_MAX_VIEWERS=20
# LIVE_MONTHLY_MINUTES=4500
# Subscriptions (tiers). Payments are pluggable and OFF: checkout says "Coming soon" until PAYMENTS_LIVE=1 and a provider is configured.
FEATURE_SUBSCRIPTIONS=0
PAYMENTS_LIVE=0
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_BUNDLE_ID=
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
WEB_PAYMENTS_ENABLED=0
WEB_PAYMENTS_SECRET_KEY=
# FOLLOW_DAILY_LIMIT=500

# Rounds 7-9, news and starter content (all off by default)
FEATURE_ADD_YOURS=false
FEATURE_AI_VISION=false
FEATURE_AI_VOICE=false
FEATURE_AR_EFFECTS=false
FEATURE_BACKFILL=false
FEATURE_CALLS=false
FEATURE_CHALLENGES=false
FEATURE_CLOSE_FRIENDS=false
FEATURE_COLLECTIONS=false
FEATURE_CREATOR_TOOLS=false
FEATURE_DATA_EXPORT=false
FEATURE_DISAPPEARING=false
FEATURE_DISCOVERABILITY=false
FEATURE_EVENTS=false
FEATURE_FOR_YOU=false
FEATURE_GAMES=false
FEATURE_GIFTS=false
FEATURE_HASHTAGS=false
FEATURE_HIDDEN_WORDS=false
FEATURE_HIDE_LIKES=false
FEATURE_HIDE_LISTS=false
FEATURE_HIDE_PRESENCE=false
FEATURE_I18N=false
FEATURE_LOGIN_ALERTS=false
FEATURE_MEMORIES=false
FEATURE_MESSAGES=false
FEATURE_MUSIC=false
FEATURE_NEWS=false
FEATURE_POLLS=false
FEATURE_PRIVATE_ACCOUNTS=false
FEATURE_PUSH=false
FEATURE_REELS=false
FEATURE_REMIX=false
FEATURE_REPORTS=false
FEATURE_RESTRICT_MUTE=false
FEATURE_SIGNUP_POW=false
FEATURE_STICKERS=false
FEATURE_STREAKS=false
FEATURE_TEEN_SAFETY=false
FEATURE_TRANSLATE=false
FEATURE_TWO_STEP=false
FEATURE_VERIFIED=false
FEATURE_WATCH_TOGETHER=false
FEATURE_WELCOME_HERO=false
FEATURE_WHO_CAN=false
# VAPID keys for push live only in the server .env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
